; SAP2000 v7 input file
SYSTEM
  DOF=UX,UY,UZ,RX,RY,RZ  LENGTH=IN  FORCE=KIP

JOINT
  1  X=0  Y=0  Z=0
  2  X=60  Y=0  Z=0
  3  X=120  Y=0  Z=0

RESTRAINT
  ADD=1  DOF=U1,U2,U3,R1,R2,R3

MATERIAL
  NAME=STEEL  IDES=S  M=7.324E-07  W=0
    E=29000  U=0.3  A=6.5E-06

FRAME SECTION
  NAME=FSEC1  MAT=STEEL  A=10  J=50  I=200,40  AS=0,0

FRAME
  1  J=1,2  SEC=FSEC1  ANG=0
  2  J=2,3  SEC=FSEC1  ANG=0

LOAD
  NAME=TIP
    TYPE=FORCE
      ADD=3  UZ=-1
  NAME=UDL
    TYPE=DISTRIBUTED SPAN
      ADD=1,2,1  RD=0,1  UZ=-0.01,-0.01

COMBO
  NAME=C1  TYPE=ADD
    LOAD=TIP  SF=2

END
